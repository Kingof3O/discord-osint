# =====================================================================
# Discord OSINT Configuration (.env)
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Discord Authentication & Network
# ---------------------------------------------------------------------
# Discord User Token (REQUIRED for search & live scans)
# Note: Keep this private. The tool automatically scrubs tokens from logs.
DISCORD_TOKEN=

# Optional HTTP or SOCKS5 Proxy (e.g., socks5://127.0.0.1:9050 or http://user:pass@host:8080)
PROXY=

# Optional Cloudflare session cookies for Disboard (if Cloudflare challenge blocks access)
DISBOARD_COOKIES=

# ---------------------------------------------------------------------
# AI Threat Intelligence & Evidence Triage (OpenCode Zen / Muse Spark)
# ---------------------------------------------------------------------
# OpenCode Zen API Key (from https://opencode.ai)
OPENCODE_API_KEY=

# OpenCode Zen Base URL (OpenAI-compatible v1 endpoint)
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# OpenCode Zen Model Identifier:
# For Muse Spark Free contributor tier:
#   - muse-spark-1.3-contributor-free  (Current free contributor tier)
#   - muse-spark-1.3-contributor       (Contributor tier alias)
#   - musespark-1.3                    (Standard v1.3 release)
AI_MODEL=muse-spark-1.3-contributor-free

# (Optional) Fallback if using direct OpenAI instead of OpenCode Zen
OPENAI_API_KEY=

# ---------------------------------------------------------------------
# Local Storage & Verification
# ---------------------------------------------------------------------
# SQLite database storage path (default: run.sqlite)
DATABASE_PATH=run.sqlite

# Custom browser binary path for AltDentifier / DoubleCounter external bridge (optional)
# e.g., /Applications/Brave Browser.app/Contents/MacOS/Brave Browser
BROWSER_EXEC=

# Log Level: info or debug
LOG_LEVEL=info
